{
    "schemaVersion": 1,
    "plugin": "回声编辑台",
    "entries": [
        {
            "version": "0.1.9",
            "date": "2026-11-19",
            "changes": {
                "新增": [
                    "电脑双栏布局：左侧目录、右侧编辑，支持调整目录宽度和切换单栏。",
                    "预设历史版本：保存时填写版本号与说明，可载入旧版继续编辑。",
                    "正文批量替换：支持预览、勾选和撤销，替换结果先留为未保存修改。",
                    "彻底删除条目：与“移出排列”区分，删除前需确认。"
                ],
                "优化": [
                    "调整标题字体、菜单位置和编辑状态提示，改善草稿、光标与滚动位置保留。",
                    "电脑端新增仍通过“在上方新增 / 在下方新增”，不增加独立新增按钮。"
                ],
                "修复": []
            }
        },
        {
            "version": "0.1.7",
            "date": "2026-11-17",
            "changes": {
                "新增": [
                    "支持搜索条目标题和正文，快速找到需要编辑的内容。",
                    "支持按成对条目名称建立分组，可折叠、整组拖动和批量启停。"
                ],
                "优化": [
                    "移除顶部“新建条目”按钮，可直接在条目前后或分组内新增。",
                    "搜索时自动展开相关分组，清空搜索后恢复原来的折叠状态。"
                ],
                "修复": []
            }
        }
    ]
}
